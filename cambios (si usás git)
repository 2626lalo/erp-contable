[32m+[m[41m    [m
[32m+[m[32m    const facturaA = comprasA.reduce((s, c) => s + (c.total || 0), 0);[m
[32m+[m[32m    const facturaB = comprasB.reduce((s, c) => s + (c.total || 0), 0);[m
